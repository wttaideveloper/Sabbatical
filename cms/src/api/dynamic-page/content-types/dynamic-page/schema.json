{
  "kind": "collectionType",
  "collectionName": "dynamic_pages",
  "info": {
    "singularName": "dynamic-page",
    "pluralName": "dynamic-pages",
    "displayName": "Page",
    "description": "Admin-created pages, built entirely from the page builder, published at /{slug}"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true,
      "regex": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "The page's URL — published at yoursite.com/{slug}. Lowercase letters, numbers, and hyphens only."
    },
    "seoDescription": {
      "type": "text",
      "description": "Optional — shown in search results and link previews"
    },
    "heroEyebrow": { "type": "string" },
    "heroTitle": { "type": "string", "required": true },
    "heroLead": { "type": "text" },
    "heroImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "heroBackgroundColor": { "type": "string", "regex": "^#[0-9A-Fa-f]{6}$" },
    "heroTextColor": { "type": "string", "regex": "^#[0-9A-Fa-f]{6}$" },
    "heroFontFamily": { "type": "enumeration", "enum": ["montserrat", "playfair", "lora", "cormorant", "inter"] },
    "sections": { "type": "component", "component": "sections.custom-block", "repeatable": true }
  }
}
