# =============================================================================
# Intimate Sabbatical — STRAPI CMS environment template
#
# Copy to "cms/.env" (read by docker-compose.yml via CMS_ENV_FILE, and by `strapi develop` locally).
# This file contains PLACEHOLDERS ONLY. Never commit a real ".env". Keep the real one chmod 600.
# In production Strapi REFUSES TO START if a required value is empty or still a placeholder.
#
# Legend
#   [SECRET]    server-side secret, never put it in an image or in git.
#   [GENERATE]  must be a freshly generated random value (commands in DEPLOYMENT.md).
#   [REPLACE]   placeholder you must replace once the real domain exists.
#
# On the SERVER, create this file from this template with freshly generated production values.
# Never copy your local development cms/.env there (its secrets are for local use only).
# Docker Compose parses this file and expands "$" in values: generate secrets with
# `openssl rand -hex 32` (no "$"), or wrap a value that must contain "$" or "#" in single quotes.
# =============================================================================


# ----------------------------- Server ------------------------------------------------------

HOST=0.0.0.0
PORT=1337

# [REPLACE] Public HTTPS URL of the CMS (the one nginx serves). Required in production.
# Local development: http://localhost:1337
PUBLIC_URL=https://CMS_DOMAIN_REPLACE_ME

# true behind nginx / any reverse proxy (production). false for plain local development.
IS_PROXIED=true

# [REPLACE] Comma-separated browser origins allowed to call the CMS (CORS): the public website
# and the CMS itself. Required in production.
# Local development: http://localhost:3000,http://localhost:1337
CORS_ORIGINS=https://WEB_DOMAIN_REPLACE_ME,https://CMS_DOMAIN_REPLACE_ME


# ----------------------------- Secrets (all [SECRET] + [GENERATE]) -------------------------

# Comma-separated list of 4 random keys (session signing).
APP_KEYS=REPLACE_ME_KEY_1,REPLACE_ME_KEY_2,REPLACE_ME_KEY_3,REPLACE_ME_KEY_4
API_TOKEN_SALT=REPLACE_ME
ADMIN_JWT_SECRET=REPLACE_ME
TRANSFER_TOKEN_SALT=REPLACE_ME
ENCRYPTION_KEY=REPLACE_ME
# Secret for the users-permissions plugin's JWTs.
JWT_SECRET=REPLACE_ME


# ----------------------------- Database (SQLite) -------------------------------------------

DATABASE_CLIENT=sqlite
# MUST be a RELATIVE path inside the app directory (an absolute path is rejected on purpose).
# In Docker the host directory <APP_DATA_DIR>/database is mounted at /opt/app/.tmp.
DATABASE_FILENAME=.tmp/data.db


# ----------------------------- Content seeding (development only) --------------------------

# Seeds sample pages, blog posts, products and booking services. Only honoured when NODE_ENV is
# NOT "production" — production never seeds, whatever this says. Leave false by default.
STRAPI_SEED=false

# One-shot: set to true for a single start to re-apply the default PUBLIC READ permissions
# (it only adds missing find/findOne grants, never write access). Normally leave unset.
# STRAPI_SYNC_PUBLIC_PERMISSIONS=false


# ----------------------------- Feature flags / telemetry -----------------------------------

FLAG_NPS=false
FLAG_PROMOTE_EE=false
FLAG_DOC_LINKS=true
STRAPI_TELEMETRY_DISABLED=true
