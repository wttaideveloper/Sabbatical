# Docker build context for the Next.js frontend image (repository root).
# Keep secrets, local state and the separate CMS project OUT of the image.

# version control / editor / agent tooling
.git
.gitignore
.gitattributes
.claude
.vscode
.idea

# dependencies and build output (rebuilt inside the image)
node_modules
.next
out
build
coverage
*.tsbuildinfo
next-env.d.ts

# environment files: never copied into an image (templates are excluded too — not needed to build)
.env
.env.*

# the CMS has its own Dockerfile and build context (./cms)
cms

# deployment tooling and docs are not part of the app image
deploy
Dockerfile
docker-compose.yml
.dockerignore
*.md

# logs / OS noise
npm-debug.log*
yarn-debug.log*
.DS_Store
Thumbs.db
