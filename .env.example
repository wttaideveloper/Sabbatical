# =============================================================================
# Intimate Sabbatical — FRONTEND / DEPLOYMENT environment template
#
# Copy to ".env" (production, next to docker-compose.yml) or ".env.local" (local development).
# This file contains PLACEHOLDERS ONLY. Never commit a real ".env". Keep the real one chmod 600.
#
# Legend
#   [PUBLIC / BUILD]   inlined into the browser bundle at build time. Not secret. Changing it
#                      requires rebuilding the image.
#   [SECRET / RUNTIME] server-side only, injected at container start. Never baked into an image.
#   [GENERATE]         must be a freshly generated random value (commands in DEPLOYMENT.md).
#   [REPLACE]          placeholder you must replace once the real domain / address exists.
#
# On the SERVER, create this file from this template with freshly generated production values.
# Never copy your local development .env there.
# Docker Compose parses this file and expands "$" in values: generate secrets with
# `openssl rand -hex 32` (no "$"), or wrap a value that must contain "$" or "#" in single quotes.
# =============================================================================


# ----------------------------- Deployment (docker-compose.yml) ----------------------------

# Compose project name. Keep as-is: every container/network is namespaced by it.
COMPOSE_PROJECT_NAME=intimate-sabbatical

# Host directory holding persistent data (database/, cms-uploads/, backups/).
APP_DATA_DIR=/srv/appdata/intimate-sabbatical

# Loopback host ports (127.0.0.1 only). 4300/4301 are CANDIDATES: check on the VPS that both are
# free BEFORE deploying (see DEPLOYMENT.md), and make deploy/nginx/*.template match.
WEB_HOST_PORT=4300
CMS_HOST_PORT=4301

# Tag for the images (e.g. a date or git SHA). Use a new tag per release so you can roll back.
IMAGE_TAG=local

# Where docker-compose reads the CMS environment from (see cms/.env.example).
CMS_ENV_FILE=./cms/.env

# Optional resource caps, to protect the other projects on the VPS.
# WEB_MEM_LIMIT=512m
# WEB_CPUS=1.0
# CMS_MEM_LIMIT=1g
# CMS_CPUS=1.0


# ----------------------------- Frontend: PUBLIC, BUILD-TIME -------------------------------
# Passed as build arguments by `docker compose build`. They end up in the browser bundle.

# [PUBLIC / BUILD] [REPLACE] Public URL of the CMS. Used ONLY for browser-facing media (images,
# uploaded videos). Server-to-server API calls use STRAPI_INTERNAL_URL instead.
# Local development default (if unset): http://localhost:1337
NEXT_PUBLIC_CMS_PUBLIC_URL=https://CMS_DOMAIN_REPLACE_ME

# [PUBLIC / BUILD] [REPLACE] Public URL of this website (metadataBase / canonical / Open Graph).
# Local development default (if unset): http://localhost:3000
NEXT_PUBLIC_WEB_URL=https://WEB_DOMAIN_REPLACE_ME

# [PUBLIC / BUILD] [REPLACE] Address that contact and booking-request emails go to.
NEXT_PUBLIC_CONTACT_EMAIL=CONTACT_EMAIL_REPLACE_ME

# [PUBLIC / BUILD] Optional. Link to the Fullscript dispensary shown on /shop. Leave empty to hide.
NEXT_PUBLIC_FULLSCRIPT_URL=


# ----------------------------- Frontend: RUNTIME ------------------------------------------

# Server-side address of Strapi. Inside Docker this is fixed by docker-compose.yml to
# http://cms:1337 (the private network). For local development it defaults to
# http://localhost:1337 and does not need to be set. Production has no fallback.
# STRAPI_INTERNAL_URL=http://cms:1337

# [SECRET / RUNTIME] Strapi API token used by the /admin panel for drafts, writes and publishing.
# Created in the Strapi admin AFTER first start (Settings -> API Tokens). Give it a restricted
# custom permission set and an expiry — see DEPLOYMENT.md. Leave empty on the very first deploy.
STRAPI_API_TOKEN=

# [SECRET / RUNTIME] [GENERATE] Password for the custom /admin panel. In production it must be
# at least 12 characters, otherwise admin sign-in is disabled.
ADMIN_PANEL_PASSWORD=

# [SECRET / RUNTIME] [GENERATE] Secret used to sign admin session cookies. In production it must
# be at least 32 characters. Rotating it (or the password) signs everyone out.
ADMIN_SESSION_SECRET=

# Set by docker-compose.yml / the image — do NOT put these in .env.local for local development
# (a NODE_ENV in .env files confuses `next dev`).
#   NODE_ENV=production
#   PORT=3000
#   HOSTNAME=0.0.0.0
